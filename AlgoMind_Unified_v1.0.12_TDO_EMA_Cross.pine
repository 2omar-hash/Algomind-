//@version=6
// AlgoMind Unified v1.0.12 - TDO Ownership Research + EMA Momentum Cross.
// Integration research build: not a byte-identical port of EXEC v1.4.2.
// EXEC-derived sole READY authority. Fusion-derived context has NO READY authority.
indicator("AlgoMind Unified v1.0.12 | TDO + EMA Momentum Cross", "AlgoMind Unified 1.0.12", overlay=true, max_lines_count=90, max_labels_count=100, max_boxes_count=16)
string GL="1. Qualified liquidity"
string GE="2. EXEC confirmation"
string GR="3. Risk"
string GC="4. Context only"
string GD="5. Display"
use4=input.bool(true,"4H",group=GL)
use1=input.bool(true,"1H",group=GL)
useSession=input.bool(true,"Completed sessions",group=GL)
usePD=input.bool(true,"Previous day",group=GL)
minSweep=input.float(0.05,"Sweep penetration ATR",minval=0,step=.01,group=GL)
minReclaim=input.float(0.05,"Close-back ATR",minval=0,step=.01,group=GL)
maxSweepBars=input.int(60,"Sweep to confirmation: M5 bars",minval=6,group=GE)
swing=input.int(3,"M5 MSS swing",minval=1,group=GE)
mssAtr=input.float(.08,"MSS clearance ATR",minval=0,step=.01,group=GE)
dispAtr=input.float(.65,"Displacement body ATR",minval=.1,step=.05,group=GE)
maxDispBars=input.int(6,"MSS to displacement bars",minval=1,group=GE)
minGapAtr=input.float(.08,"15M FVG minimum width / 15M ATR",minval=0,step=.01,group=GE)
maxGapBars=input.int(12,"Displacement to 15M FVG: M5 bars",minval=1,group=GE)
allowInverse=input.bool(true,"Enable 15M IFVG alternative",group=GE)
minRR=input.float(2.0,"Minimum realistic RR",minval=1,step=.25,group=GR)
stopPad=input.float(.10,"Structural stop buffer ATR",minval=0,step=.05,group=GR)
maxChase=input.float(.35,"Maximum close distance from CE ATR",minval=0,step=.05,group=GR)
expiry=input.int(100,"Setup expiry: M5 bars",minval=10,group=GR)
showEMA=input.bool(true,"20 / 50 EMA",group=GC)
showEMACross=input.bool(true,"Show EMA20/50 crossover markers",group=GC)
emaCrossConfirmedOnly=input.bool(true,"EMA cross: confirmed M5 close only",group=GC)
showLiq=input.bool(true,"Nearest BSL / SSL",group=GD)
showZone=input.bool(true,"Active execution zone",group=GD)
showCELabel=input.bool(true,"15M FVG / IFVG CE price label",group=GD)
show4HClock=input.bool(true,"4H close countdown / candle state",group=GD)
showDash=input.bool(true,"Show dashboard",group=GD)
dashMode=input.string("Compact","Dashboard view",options=["Compact","Detailed"],group=GD)
showContextFVG=input.bool(true,"Independent confirmed 15M FVG / IFVG map",group=GD)
showContextCE=input.bool(true,"Context 15M CE price markers",group=GD)
contextExtend=input.int(28,"Context FVG extension (M5 bars)",minval=3,maxval=100,group=GD)
showTargetGuides=input.bool(true,"Show provisional / READY target guides",group=GD)
navLength=input.int(30,"NAV segment length (bars)",minval=5,maxval=200,group=GD)
// Daily reference overlay: does not feed the liquidity registry or EXEC.
string GDR="6. Daily reference lines (visual only)"
showPDH=input.bool(true,"Show PDH",group=GDR)
showPDL=input.bool(true,"Show PDL",group=GDR)
showTDO=input.bool(true,"Show TDO",group=GDR)
tdoMode=input.string("New York midnight","TDO reference",options=["New York midnight","TradingView daily open"],group=GDR)
refLineWidth=input.int(2,"Dashed line thickness",minval=1,maxval=4,group=GDR)
refLabelOffset=input.int(6,"Price label offset (bars)",minval=1,maxval=30,group=GDR)
// v1.0.11 TDO Ownership Research. Conservative, observational and display-only.
string GTDO="10. TDO ownership research (display only)"
showTdoFlow=input.bool(true,"Show TDO FLOW",group=GTDO)
tdoOwnBars=input.int(24,"Ownership lookback (M5 bars)",minval=12,maxval=72,group=GTDO)
tdoOwnPct=input.float(80.0,"Minimum closes on owned side %",minval=60,maxval=100,step=5,group=GTDO)
tdoMinDistATR=input.float(0.10,"Minimum current distance from TDO ATR",minval=0,step=0.05,group=GTDO)
// v1.0.9 research layer. These settings NEVER gate READY or write EXEC state.
string GCS="8. Real-time liquidity / counter research"
showRT=input.bool(true,"Show LIVE liquidity observer",group=GCS)
showCounter=input.bool(true,"Show confirmed counter-structure",group=GCS)
counterExpiry=input.int(60,"Counter event observation window (M5 bars)",minval=6,maxval=144,group=GCS)
// v1.0.10 Position Maturity Engine. Research/display only. Never gates READY or changes EXEC.
string GPME="9. Position maturity research (display only)"
showPME=input.bool(true,"Show Position Maturity Engine",group=GPME)
pmeMaxBars=input.int(72,"Position observation window (M5 bars)",minval=6,maxval=288,group=GPME)
pmeMatureATR=input.float(2.0,"Mature excursion (entry ATR)",minval=0.25,step=0.25,group=GPME)
pmeMatureJourney=input.float(75.0,"Mature target journey %",minval=25,maxval=100,step=5,group=GPME)
pmeGivebackWarn=input.float(25.0,"Giveback warning % of MFE",minval=5,maxval=90,step=5,group=GPME)
pmeStallBars=input.int(4,"No-new-MFE stall bars",minval=2,maxval=20,group=GPME)
// The integration runs ONLY on M5, so MSS and confirmed CE rejection cannot silently
// become different signals when users change the chart timeframe.
bool onM5=timeframe.isminutes and timeframe.multiplier==5
float atr=ta.atr(14)
float e20=ta.ema(close,20)
float e50=ta.ema(close,50)
plot(showEMA?e20:na,"EMA20",color=color.new(color.teal,35))
plot(showEMA?e50:na,"EMA50",color=color.new(color.orange,40))

// EMA MOMENTUM CROSS - DISPLAY / ALERT ONLY.
// This confirms short-term momentum when EMA20 crosses EMA50.
// It does NOT alter READY, EXEC ownership, TDO ownership, targets or risk.
bool emaBullCrossRaw=ta.crossover(e20,e50)
bool emaBearCrossRaw=ta.crossunder(e20,e50)
bool emaCrossBarOk=onM5 and (not emaCrossConfirmedOnly or barstate.isconfirmed)
bool emaBullCross=emaCrossBarOk and emaBullCrossRaw
bool emaBearCross=emaCrossBarOk and emaBearCrossRaw
plotshape(showEMACross and emaBullCross,title="EMA Bull Cross",text="EMA↑",style=shape.labelup,location=location.belowbar,color=color.new(color.teal,0),textcolor=color.white,size=size.tiny)
plotshape(showEMACross and emaBearCross,title="EMA Bear Cross",text="EMA↓",style=shape.labeldown,location=location.abovebar,color=color.new(color.orange,0),textcolor=color.white,size=size.tiny)
// Completed HTF values: previous HTF bar sampled with lookahead_on is confirmed.
[h4h,h4l,h4t]=request.security(syminfo.tickerid,"240",[high[1],low[1],time[1]],lookahead=barmerge.lookahead_on)
[h1h,h1l,h1t]=request.security(syminfo.tickerid,"60",[high[1],low[1],time[1]],lookahead=barmerge.lookahead_on)
[pdh,pdl,pdt]=request.security(syminfo.tickerid,"D",[high[1],low[1],time[1]],lookahead=barmerge.lookahead_on)
[hc,he20,he50]=request.security(syminfo.tickerid,"240",[close[1],ta.ema(close,20)[1],ta.ema(close,50)[1]],lookahead=barmerge.lookahead_on)
[cc,ce20,ce50]=request.security(syminfo.tickerid,"60",[close[1],ta.ema(close,20)[1],ta.ema(close,50)[1]],lookahead=barmerge.lookahead_on)
int bias4=hc>he20 and he20>he50?1:hc<he20 and he20<he50?-1:0
int bias1=cc>ce20 and ce20>ce50?1:cc<ce20 and ce20<ce50?-1:0
// Fusion SuperTrend is shown as separate context; it never gates READY.
f_st()=>
    [v,d]=ta.supertrend(1.0,10)
    d[1]
float st4=request.security(syminfo.tickerid,"240",f_st(),lookahead=barmerge.lookahead_on)
float st1=request.security(syminfo.tickerid,"60",f_st(),lookahead=barmerge.lookahead_on)
string fusionBias=st4<0 and st1<0?"BULL":st4>0 and st1>0?"BEAR":"MIXED"
// One canonical liquidity registry. Coincident levels merge into one owner,
// while secondary source names are appended to the dominant ribbon.
var array<float> levels=array.new_float()
var array<int> sides=array.new_int()
var array<int> ranks=array.new_int()
var array<string> sources=array.new_string()
var array<bool> live=array.new_bool()
add(float p,int side,int rank,string source)=>
    if not na(p)
        int found=-1
        if array.size(levels)>0
            for i=0 to array.size(levels)-1
                if array.get(live,i) and array.get(sides,i)==side and math.abs(array.get(levels,i)-p)<=math.max(syminfo.mintick*3,atr*.012)
                    found:=i
                    break
        if found>=0
            string old=array.get(sources,found)
            if not str.contains(old,source)
                array.set(sources,found,rank<array.get(ranks,found)?source+" + "+old:old+" + "+source)
            if rank<array.get(ranks,found)
                array.set(ranks,found,rank)
                array.set(levels,found,p)
        else
            array.push(levels,p),array.push(sides,side),array.push(ranks,rank),array.push(sources,source),array.push(live,true)
if onM5 and use4 and ta.change(h4t)!=0
    add(h4h,1,1,"4H"),add(h4l,-1,1,"4H")
if onM5 and use1 and ta.change(h1t)!=0
    add(h1h,1,2,"1H"),add(h1l,-1,2,"1H")
if onM5 and usePD and ta.change(pdt)!=0
    add(pdh,1,4,"PDH"),add(pdl,-1,4,"PDL")
// Session times are New York local. Only completed session extremes are registered.
string tz="America/New_York"
bool a=not na(time(timeframe.period,"2000-0000",tz))
bool l=not na(time(timeframe.period,"0200-0500",tz))
bool n=not na(time(timeframe.period,"0830-1100",tz))
var float ah=na
var float al=na
var float lh=na
var float ll=na
var float nh=na
var float nl=na
if a and not a[1]
    ah:=high,al:=low
else if a
    ah:=math.max(ah,high),al:=math.min(al,low)
if l and not l[1]
    lh:=high,ll:=low
else if l
    lh:=math.max(lh,high),ll:=math.min(ll,low)
if n and not n[1]
    nh:=high,nl:=low
else if n
    nh:=math.max(nh,high),nl:=math.min(nl,low)
if onM5 and useSession and not a and a[1]
    add(ah,1,3,"Asia"),add(al,-1,3,"Asia")
if onM5 and useSession and not l and l[1]
    add(lh,1,3,"London"),add(ll,-1,3,"London")
if onM5 and useSession and not n and n[1]
    add(nh,1,3,"NY"),add(nl,-1,3,"NY")
// ============================================================================
// EXEC state is declared before the research observers so they can READ it.
// The research module never writes these EXEC variables.
var bool active=false
var bool consumed=false
var int dir=0
var int sweepBar=na
var int mssBar=na
var int dispBar=na
var int gapBar=na
var float sweepPrice=na
var float sweepExtreme=na
var float zoneTop=na
var float zoneBottom=na
var float opTop=na
var float opBottom=na
var int opTime=na
var string owner=""
var string branch=""
var string status="WAIT"
var bool mss=false
var bool disp=false
var bool gap=false
var bool ceTouched=false
var float entry=na
var float stop=na
var float target=na
var float rr=na
var box zoneBox=na
var line sweepLine=na
var label sweepLabel=na
// VISUAL ONLY: independent horizontal NAV segments, never used for trade selection.
var line navBSL=na
var line navSSL=na
var line ceGuide=na
var label ceGuideLabel=na
var float navBSLPrice=na
var float navSSLPrice=na
var line guideEntry=na
var line guideStop=na
var line guideTarget=na
var label guideLabel=na

// v1.0.9 REAL-TIME LIQUIDITY + COUNTER-STRUCTURE RESEARCH ONLY
// STRICT SEPARATION:
// LIVE: TOUCH -> PENETRATION -> SWEEPING -> RECLAIM?
// CONFIRMED EVENT: QUALIFIED SWEEP -> MSS -> DISP
// EXEC below is unchanged and remains the sole READY authority.
// This block NEVER writes active/consumed/dir/sweepPrice/mss/disp/gap/READY.
// ============================================================================
var string rtState="NONE"
var string rtOwner=""
var int rtSide=0
var float rtLevel=na
var float rtPenATR=na
int rtPick=-1
int rtPickRank=99
string rtPickState="NONE"
float rtPickPen=na
if onM5 and array.size(levels)>0
    for i=0 to array.size(levels)-1
        if array.get(live,i)
            float rp=array.get(levels,i)
            int rs=array.get(sides,i)
            float rawPen=rs==1?high-rp:rp-low
            bool rtTouchNow=rs==1?high>=rp:low<=rp
            bool rtPenNow=rawPen>0
            bool rtSweepNow=rawPen>=atr*minSweep
            bool rtReclaimNow=rtSweepNow and (rs==1?close<rp:close>rp)
            string candidateState=rtReclaimNow?"RECLAIM?":rtSweepNow?"SWEEPING":rtPenNow?"PENETRATION":rtTouchNow?"TOUCH":"NONE"
            if candidateState!="NONE" and array.get(ranks,i)<rtPickRank
                rtPick:=i
                rtPickRank:=array.get(ranks,i)
                rtPickState:=candidateState
                rtPickPen:=math.max(0.0,rawPen/math.max(atr,syminfo.mintick))
if rtPick>=0
    rtState:=rtPickState
    rtOwner:=array.get(sources,rtPick)
    rtSide:=array.get(sides,rtPick)
    rtLevel:=array.get(levels,rtPick)
    rtPenATR:=rtPickPen
else
    rtState:="NONE"
    rtOwner:=""
    rtSide:=0
    rtLevel:=na
    rtPenATR:=na

// Highest-priority QUALIFIED sweep on this confirmed M5 bar, observed independently
// of whether EXEC already has a locked owner.
int researchWinner=-1
int researchRank=99
int researchSide=0
if onM5 and barstate.isconfirmed and array.size(levels)>0
    for i=0 to array.size(levels)-1
        if array.get(live,i)
            float rp=array.get(levels,i)
            int rs=array.get(sides,i)
            bool rq=rs==1?high>rp+atr*minSweep and close<rp-atr*minReclaim:low<rp-atr*minSweep and close>rp+atr*minReclaim
            if rq and array.get(ranks,i)<researchRank
                researchWinner:=i
                researchRank:=array.get(ranks,i)
                researchSide:=rs

// Research-only M5 pivots mirror EXEC settings without writing EXEC variables.
float researchPh=ta.pivothigh(high,swing,swing)
float researchPl=ta.pivotlow(low,swing,swing)
var float researchLastHigh=na
var float researchLastLow=na
if not na(researchPh)
    researchLastHigh:=researchPh
if not na(researchPl)
    researchLastLow:=researchPl

// Counter event has its own state. It cannot replace or modify EXEC ownership.
var bool counterActive=false
var int counterDir=0
var int counterSweepBar=na
var int counterMssBar=na
var int counterDispBar=na
var float counterLevel=na
var float counterExtreme=na
var string counterOwner=""
var bool counterMss=false
var bool counterDisp=false
var string counterState="NONE"

// A counter candidate is born only when an opposite qualified sweep occurs while
// a PRIMARY EXEC setup is active. This is research classification, not an entry.
bool newCounter=active and not counterActive and researchWinner>=0 and -researchSide==-dir
if newCounter
    counterActive:=true
    counterDir:=-researchSide
    counterSweepBar:=bar_index
    counterMssBar:=na
    counterDispBar:=na
    counterLevel:=array.get(levels,researchWinner)
    counterExtreme:=counterDir==1?low:high
    counterOwner:=array.get(sources,researchWinner)
    counterMss:=false
    counterDisp:=false
    counterState:="QUALIFIED SWEEP ✓"

if counterActive and onM5 and barstate.isconfirmed
    counterExtreme:=counterDir==1?math.min(counterExtreme,low):math.max(counterExtreme,high)
    if bar_index-counterSweepBar>counterExpiry
        counterActive:=false
        counterState:="OBSERVATION ENDED"
    else
        bool counterBullMss=not na(researchLastHigh) and close>researchLastHigh+atr*mssAtr and close[1]<=researchLastHigh
        bool counterBearMss=not na(researchLastLow) and close<researchLastLow-atr*mssAtr and close[1]>=researchLastLow
        if not counterMss and bar_index-counterSweepBar<=maxSweepBars and (counterDir==1?counterBullMss:counterBearMss)
            counterMss:=true
            counterMssBar:=bar_index
            counterState:="MSS ✓ | WAIT DISP"
        if counterMss and not counterDisp and bar_index>=counterMssBar and bar_index-counterMssBar<=maxDispBars and (counterDir==1?close>open:close<open) and math.abs(close-open)>=atr*dispAtr
            counterDisp:=true
            counterDispBar:=bar_index
            counterState:="MSS ✓ | DISP ✓"
        if counterMss and not counterDisp and bar_index-counterMssBar>maxDispBars
            counterActive:=false
            counterState:="DISP TIMEOUT"

string liveText=not showRT?"HIDDEN":rtState=="NONE"?"NONE":rtOwner+" "+(rtSide==1?"BSL":"SSL")+" | "+rtState+(na(rtPenATR)?"":" | "+str.tostring(rtPenATR,"#.##")+" ATR")
string counterText=not showCounter?"HIDDEN":counterState=="NONE"?"NONE":counterOwner+" "+(counterDir==1?"SSL ↑":"BSL ↓")+" | "+counterState
// ============================================================================
// END v1.0.9 RESEARCH LAYERS. Original EXEC starts below.
// ============================================================================
// Retire invalid-side levels after checking for sweeps on the confirmed bar.
float upper=na
float lower=na
int winner=-1
int winningRank=99
int winningSide=0
if array.size(levels)>0
    for i=0 to array.size(levels)-1
        if array.get(live,i)
            float p=array.get(levels,i)
            int s=array.get(sides,i)
            if s==1 and p>close and (na(upper) or p<upper)
                upper:=p
            if s==-1 and p<close and (na(lower) or p>lower)
                lower:=p
            bool swept=onM5 and barstate.isconfirmed and (s==1?high>p+atr*minSweep and close<p-atr*minReclaim:low<p-atr*minSweep and close>p+atr*minReclaim)
            if swept and not active and array.get(ranks,i)<winningRank
                winner:=i,winningRank:=array.get(ranks,i),winningSide:=s
            // No invalid-side levels remain as future target candidates.
            if onM5 and barstate.isconfirmed and ((s==1 and close>=p) or (s==-1 and close<=p) or swept)
                array.set(live,i,false)
// Once a setup is locked, subsequent sweeps cannot replace it.
if onM5 and barstate.isconfirmed and winner>=0 and not active
    active:=true,consumed:=false,dir:=-winningSide
    sweepBar:=bar_index,sweepPrice:=array.get(levels,winner)
    sweepExtreme:=dir==1?low:high
    owner:=array.get(sources,winner)
    mss:=false,disp:=false,gap:=false,ceTouched:=false
    mssBar:=na,dispBar:=na,gapBar:=na
    zoneTop:=na,zoneBottom:=na,opTop:=na,opBottom:=na,opTime:=na
    entry:=na,stop:=na,target:=na,rr:=na,branch:=""
    status:="SWEEP LOCKED"
    if not na(zoneBox)
        box.delete(zoneBox),zoneBox:=na
    if not na(sweepLine)
        line.delete(sweepLine)
    if not na(sweepLabel)
        label.delete(sweepLabel)
    sweepLine:=line.new(bar_index,sweepPrice,bar_index+20,sweepPrice,color=dir==1?color.teal:color.red,style=line.style_dashed)
    sweepLabel:=label.new(bar_index,sweepPrice,owner+(dir==1?" SSL SWEPT ✓":" BSL SWEPT ✓"),style=label.style_label_left,color=dir==1?color.teal:color.red,textcolor=color.white,size=size.small)
if not na(sweepLine)
    line.set_x2(sweepLine,bar_index+4)
if not na(sweepLabel)
    label.set_x(sweepLabel,bar_index+4)
float ph=ta.pivothigh(high,swing,swing)
float pl=ta.pivotlow(low,swing,swing)
var float lastHigh=na
var float lastLow=na
if not na(ph)
    lastHigh:=ph
if not na(pl)
    lastLow:=pl
bool bullMss=not na(lastHigh) and close>lastHigh+atr*mssAtr and close[1]<=lastHigh
bool bearMss=not na(lastLow) and close<lastLow-atr*mssAtr and close[1]>=lastLow
bool confirmed=onM5 and barstate.isconfirmed
if active and confirmed and not consumed
    sweepExtreme:=dir==1?math.min(sweepExtreme,low):math.max(sweepExtreme,high)
    if bar_index-sweepBar>expiry or (dir==1?close<sweepPrice-atr:close>sweepPrice+atr)
        status:="EXPIRED / INVALID",active:=false
    else
        if not mss and bar_index-sweepBar<=maxSweepBars and (dir==1?bullMss:bearMss)
            mss:=true,mssBar:=bar_index,status:="MSS CONFIRMED"
        if mss and not disp and bar_index>=mssBar and bar_index-mssBar<=maxDispBars and (dir==1?close>open:close<open) and math.abs(close-open)>=atr*dispAtr
            disp:=true,dispBar:=bar_index,status:="DISPLACEMENT"
        if mss and not disp and bar_index-mssBar>maxDispBars
            status:="DISPLACEMENT TIMEOUT",active:=false
// 15M closed-bar events, emitted once on the first M5 bar of a NEW 15M candle.
// We use the PREVIOUS 15M candle's confirmed FVG and the 15M candle before it.
[gapBull,gapBear,gTopBull,gBotBull,gTopBear,gBotBear,gAtr,tf15time,close15,prevClose15]=request.security(syminfo.tickerid,"15",[low[1]>high[3],high[1]<low[3],low[1],high[3],low[3],high[1],ta.atr(14)[1],time[1],close[1],close[2]],lookahead=barmerge.lookahead_on)
bool new15=ta.change(tf15time)!=0
// ============================================================================
// LAYER 1: independent, confirmed 15M context. No variables below are read by
// the EXEC READY condition, sweep owner, target selection or risk calculations.
// Each direction retains its latest confirmed gap. A closed 15M inversion of
// that gap is separately marked IFVG; this does NOT qualify an EXEC IFVG.
// ============================================================================
var float ctxBullTop = na
var float ctxBullBottom = na
var float ctxBearTop = na
var float ctxBearBottom = na
var int ctxBullBorn = na
var int ctxBearBorn = na
var int ctxBullState = 0  // 0 none, 1 fresh, 2 touched, 3 partial, 4 CE, 5 invalid
var int ctxBearState = 0
var bool ctxBullInverse = false
var bool ctxBearInverse = false
var box ctxBullBox = na
var box ctxBearBox = na
var line ctxBullCE = na
var line ctxBearCE = na
var label ctxBullLabel = na
var label ctxBearLabel = na
// Update older zones before registering the new confirmed 15M event.
// A bullish FVG is fully invalidated below its lower boundary; a bearish
// FVG is fully invalidated above its upper boundary. IFVGs use the inverse.
if onM5 and barstate.isconfirmed
    if ctxBullState > 0 and ctxBullState < 5 and not na(ctxBullBorn) and bar_index > ctxBullBorn
        float bullMid = (ctxBullTop + ctxBullBottom) / 2.0
        if ctxBullInverse
            ctxBullState := close > ctxBullTop ? 5 : low <= ctxBullBottom ? 4 : low <= bullMid ? 3 : low < ctxBullTop ? 2 : ctxBullState
        else
            ctxBullState := close < ctxBullBottom ? 5 : low <= ctxBullBottom ? 4 : low <= bullMid ? 4 : low < ctxBullTop ? 3 : ctxBullState
    if ctxBearState > 0 and ctxBearState < 5 and not na(ctxBearBorn) and bar_index > ctxBearBorn
        float bearMid = (ctxBearTop + ctxBearBottom) / 2.0
        if ctxBearInverse
            ctxBearState := close < ctxBearBottom ? 5 : high >= ctxBearTop ? 4 : high >= bearMid ? 3 : high > ctxBearBottom ? 2 : ctxBearState
        else
            ctxBearState := close > ctxBearTop ? 5 : high >= ctxBearTop ? 4 : high >= bearMid ? 4 : high > ctxBearBottom ? 3 : ctxBearState
if onM5 and barstate.isconfirmed and new15
    // Only the PREVIOUS, completed 15M candle is evaluated. The previous
    // candle is never allowed to invert a gap born on that same candle.
    if ctxBullState > 0 and not ctxBullInverse and not na(ctxBullBorn) and bar_index > ctxBullBorn and close15 < ctxBullBottom and prevClose15 >= ctxBullBottom
        ctxBullInverse := true
        ctxBullState := 1
        ctxBullBorn := bar_index
    if ctxBearState > 0 and not ctxBearInverse and not na(ctxBearBorn) and bar_index > ctxBearBorn and close15 > ctxBearTop and prevClose15 <= ctxBearTop
        ctxBearInverse := true
        ctxBearState := 1
        ctxBearBorn := bar_index
    // New gaps supersede only the corresponding direction's context slot.
    if gapBull and gTopBull > gBotBull and gTopBull - gBotBull >= gAtr * minGapAtr
        ctxBullTop := gTopBull
        ctxBullBottom := gBotBull
        ctxBullBorn := bar_index
        ctxBullState := 1
        ctxBullInverse := false
    if gapBear and gTopBear > gBotBear and gTopBear - gBotBear >= gAtr * minGapAtr
        ctxBearTop := gTopBear
        ctxBearBottom := gBotBear
        ctxBearBorn := bar_index
        ctxBearState := 1
        ctxBearInverse := false
ctxStateName(int state) =>
    state == 1 ? "FRESH" : state == 2 ? "TOUCHED" : state == 3 ? "PARTIAL" : state == 4 ? "CE / FILLED" : state == 5 ? "INVALID" : "NONE"
// Drawing objects are exclusively presentation. Never draw a context gap as
// an EXEC entry, stop, target or READY projection.
if barstate.islast
    if not na(ctxBullBox)
        box.delete(ctxBullBox)
        ctxBullBox := na
    if not na(ctxBearBox)
        box.delete(ctxBearBox)
        ctxBearBox := na
    if not na(ctxBullCE)
        line.delete(ctxBullCE)
        ctxBullCE := na
    if not na(ctxBearCE)
        line.delete(ctxBearCE)
        ctxBearCE := na
    if not na(ctxBullLabel)
        label.delete(ctxBullLabel)
        ctxBullLabel := na
    if not na(ctxBearLabel)
        label.delete(ctxBearLabel)
        ctxBearLabel := na
    if showContextFVG and onM5
        if ctxBullState > 0 and ctxBullState < 5 and not na(ctxBullTop)
            int bx = math.max(0, bar_index - contextExtend)
            float mid = (ctxBullTop + ctxBullBottom) / 2.0
            color bc = ctxBullInverse ? color.orange : color.teal
            ctxBullBox := box.new(bx, ctxBullTop, bar_index + 3, ctxBullBottom, bgcolor=color.new(bc, 91), border_color=color.new(bc, 55))
            if showContextCE
                ctxBullCE := line.new(bx, mid, bar_index + 4, mid, color=color.new(bc, 25), style=line.style_dotted)
                ctxBullLabel := label.new(bar_index + 4, mid, (ctxBullInverse ? "15M BEAR IFVG" : "15M BULL FVG") + " CE " + str.tostring(mid, format.mintick), style=label.style_label_left, color=color.new(bc, 40), textcolor=color.white, size=size.tiny)
        if ctxBearState > 0 and ctxBearState < 5 and not na(ctxBearTop)
            int bx = math.max(0, bar_index - contextExtend)
            float mid = (ctxBearTop + ctxBearBottom) / 2.0
            color bc = ctxBearInverse ? color.teal : color.red
            ctxBearBox := box.new(bx, ctxBearTop, bar_index + 3, ctxBearBottom, bgcolor=color.new(bc, 91), border_color=color.new(bc, 55))
            if showContextCE
                ctxBearCE := line.new(bx, mid, bar_index + 4, mid, color=color.new(bc, 25), style=line.style_dotted)
                ctxBearLabel := label.new(bar_index + 4, mid, (ctxBearInverse ? "15M BULL IFVG" : "15M BEAR FVG") + " CE " + str.tostring(mid, format.mintick), style=label.style_label_left, color=color.new(bc, 40), textcolor=color.white, size=size.tiny)
if active and disp and confirmed and new15 and bar_index>dispBar and bar_index-dispBar<=maxGapBars
    bool sameGap=(dir==1?gapBull and gTopBull-gBotBull>=gAtr*minGapAtr:gapBear and gTopBear-gBotBear>=gAtr*minGapAtr)
    bool oppositeGap=(dir==1?gapBear and gTopBear-gBotBear>=gAtr*minGapAtr:gapBull and gTopBull-gBotBull>=gAtr*minGapAtr)
    if sameGap and not gap
        gap:=true,gapBar:=bar_index,branch:="15M FVG"
        zoneTop:=dir==1?gTopBull:gTopBear
        zoneBottom:=dir==1?gBotBull:gBotBear
        status:="WAIT CE RETEST"
    if allowInverse and oppositeGap and not gap
        opTop:=dir==1?gTopBear:gTopBull
        opBottom:=dir==1?gBotBear:gBotBull
        opTime:=tf15time
// Inversion requires a distinct subsequent CLOSED 15M candle to reclaim the
// opposite gap, not a still-forming 15M candle.
if active and disp and not gap and allowInverse and confirmed and new15 and not na(opTime) and tf15time>opTime
    bool inverted=dir==1?close15>opTop and prevClose15<=opTop:close15<opBottom and prevClose15>=opBottom
    if inverted
        gap:=true,gapBar:=bar_index,branch:="15M IFVG"
        zoneTop:=opTop,zoneBottom:=opBottom
        status:="WAIT IFVG RETEST"
if active and disp and not gap and bar_index-dispBar>maxGapBars
    status:="15M GAP TIMEOUT",active:=false
if gap and active and showZone and na(zoneBox)
    zoneBox:=box.new(bar_index,zoneTop,bar_index+1,zoneBottom,bgcolor=color.new(dir==1?color.teal:color.red,87),border_color=dir==1?color.teal:color.red)
if not na(zoneBox) and active
    box.set_right(zoneBox,bar_index+2)
// Target selection uses only live, opposing liquidity on the correct side of
// the CE entry. NAV levels do not grant execution permission.
float ce=gap?(zoneTop+zoneBottom)/2:na
float structuralStop=active?(dir==1?sweepExtreme-atr*stopPad:sweepExtreme+atr*stopPad):na
float risk=gap?math.abs(close-structuralStop):na
float bestTarget=na
if gap and active and risk>syminfo.mintick and (dir==1?structuralStop<ce:structuralStop>ce)
    if array.size(levels)>0
        for i=0 to array.size(levels)-1
            if array.get(live,i) and array.get(sides,i)==dir
                float p=array.get(levels,i)
                bool valid=dir==1?p>close:p<close
                if valid and (na(bestTarget) or (dir==1?p<bestTarget:p>bestTarget))
                    bestTarget:=p
float projectedRR=not na(bestTarget) and risk>0?math.abs(bestTarget-close)/risk:na
bool geometry=gap and not na(bestTarget) and (dir==1?structuralStop<close and bestTarget>close:structuralStop>close and bestTarget<close) and projectedRR>=minRR
bool touch=gap and active and confirmed and bar_index>gapBar and low<=ce and high>=ce
if touch
    ceTouched:=true
bool reject=touch and (dir==1?close>ce and close>open:close<ce and close<open)
bool noChase=gap and math.abs(close-ce)<=atr*maxChase
bool ready=confirmed and active and not consumed and mss and disp and gap and geometry and reject and noChase
if active and gap and confirmed and (dir==1?close<zoneBottom:close>zoneTop) and not ready
    status:="ZONE INVALID",active:=false
if ready
    entry:=close,stop:=structuralStop,target:=bestTarget,rr:=projectedRR
    status:=dir==1?"BUY READY":"SELL READY"
    consumed:=true,active:=false
    label.new(bar_index,dir==1?low:high,(dir==1?"BUY":"SELL")+" READY\n"+str.tostring(rr,"#.##")+"R",style=dir==1?label.style_label_up:label.style_label_down,color=dir==1?color.teal:color.red,textcolor=color.white)
if active and gap and not ready
    status:=not geometry?"WAIT VALID >=2R TARGET":ceTouched?"WAIT M5 REJECTION":"WAIT CE RETEST"

// ============================================================================
// POSITION MATURITY ENGINE (PME) - v1.0.10 RESEARCH / DISPLAY ONLY
// Starts only from the existing READY event. It never writes active, consumed,
// dir, entry, stop, target, rr, gap, geometry or any EXEC permission variable.
// It measures post-READY excursion, target journey, MFE giveback, stall and an
// independent opposite sweep -> MSS -> displacement sequence.
// ============================================================================
var bool pmeActive=false
var int pmeDir=0
var int pmeStartBar=na
var float pmeEntry=na
var float pmeStop=na
var float pmeTarget=na
var float pmeATR=na
var float pmeBest=na
var int pmeBestBar=na
var bool pmeTargetHit=false
var bool pmeStopHit=false

// Independent post-READY counter state. This does not use or modify EXEC owner.
var bool pmeCounterActive=false
var int pmeCounterDir=0
var int pmeCounterSweepBar=na
var int pmeCounterMssBar=na
var float pmeCounterExtreme=na
var string pmeCounterOwner=""
var bool pmeCounterMss=false
var bool pmeCounterDisp=false

if ready
    pmeActive:=true
    pmeDir:=dir
    pmeStartBar:=bar_index
    pmeEntry:=close
    pmeStop:=structuralStop
    pmeTarget:=bestTarget
    pmeATR:=atr
    pmeBest:=close
    pmeBestBar:=bar_index
    pmeTargetHit:=false
    pmeStopHit:=false
    pmeCounterActive:=false
    pmeCounterDir:=0
    pmeCounterSweepBar:=na
    pmeCounterMssBar:=na
    pmeCounterExtreme:=na
    pmeCounterOwner:=""
    pmeCounterMss:=false
    pmeCounterDisp:=false

if pmeActive and onM5
    float pmeCandidate=pmeDir==1?high:low
    bool pmeNewBest=pmeDir==1?pmeCandidate>pmeBest:pmeCandidate<pmeBest
    if pmeNewBest
        pmeBest:=pmeCandidate
        pmeBestBar:=bar_index
    if not na(pmeTarget)
        pmeTargetHit:=pmeTargetHit or (pmeDir==1?high>=pmeTarget:low<=pmeTarget)
    if not na(pmeStop)
        pmeStopHit:=pmeStopHit or (pmeDir==1?low<=pmeStop:high>=pmeStop)

// A post-READY counter candidate is born from a qualified sweep opposite the
// READY direction. It is observational only and cannot create an entry/exit.
bool pmeNewCounter=pmeActive and not pmeCounterActive and researchWinner>=0 and -researchSide==-pmeDir
if pmeNewCounter
    pmeCounterActive:=true
    pmeCounterDir:=-researchSide
    pmeCounterSweepBar:=bar_index
    pmeCounterMssBar:=na
    pmeCounterExtreme:=pmeCounterDir==1?low:high
    pmeCounterOwner:=array.get(sources,researchWinner)
    pmeCounterMss:=false
    pmeCounterDisp:=false

if pmeCounterActive and onM5 and barstate.isconfirmed
    pmeCounterExtreme:=pmeCounterDir==1?math.min(pmeCounterExtreme,low):math.max(pmeCounterExtreme,high)
    if bar_index-pmeCounterSweepBar>counterExpiry
        pmeCounterActive:=false
    else
        bool pmeBullMss=not na(researchLastHigh) and close>researchLastHigh+atr*mssAtr and close[1]<=researchLastHigh
        bool pmeBearMss=not na(researchLastLow) and close<researchLastLow-atr*mssAtr and close[1]>=researchLastLow
        if not pmeCounterMss and bar_index-pmeCounterSweepBar<=maxSweepBars and (pmeCounterDir==1?pmeBullMss:pmeBearMss)
            pmeCounterMss:=true
            pmeCounterMssBar:=bar_index
        if pmeCounterMss and not pmeCounterDisp and bar_index>=pmeCounterMssBar and bar_index-pmeCounterMssBar<=maxDispBars and (pmeCounterDir==1?close>open:close<open) and math.abs(close-open)>=atr*dispAtr
            pmeCounterDisp:=true
        if pmeCounterMss and not pmeCounterDisp and bar_index-pmeCounterMssBar>maxDispBars
            pmeCounterActive:=false

float pmeMFEPrice=pmeActive and not na(pmeBest)?math.max(0.0,pmeDir==1?pmeBest-pmeEntry:pmeEntry-pmeBest):na
float pmeMFEATR=pmeActive and not na(pmeATR) and pmeATR>0?pmeMFEPrice/pmeATR:na
float pmeCurrentPrice=pmeActive?math.max(0.0,pmeDir==1?close-pmeEntry:pmeEntry-close):na
float pmeCurrentATR=pmeActive and not na(pmeATR) and pmeATR>0?pmeCurrentPrice/pmeATR:na
float pmeTargetDistance=pmeActive and not na(pmeTarget)?math.abs(pmeTarget-pmeEntry):na
float pmeJourney=pmeActive and not na(pmeTargetDistance) and pmeTargetDistance>syminfo.mintick?100.0*pmeCurrentPrice/pmeTargetDistance:na
float pmeMFEJourney=pmeActive and not na(pmeTargetDistance) and pmeTargetDistance>syminfo.mintick?100.0*pmeMFEPrice/pmeTargetDistance:na
float pmeGiveback=pmeActive and pmeMFEPrice>syminfo.mintick?100.0*math.max(0.0,pmeMFEPrice-pmeCurrentPrice)/pmeMFEPrice:0.0
bool pmeStalled=pmeActive and not na(pmeBestBar) and bar_index-pmeBestBar>=pmeStallBars
bool pmeMature=pmeActive and ((not na(pmeMFEATR) and pmeMFEATR>=pmeMatureATR) or (not na(pmeMFEJourney) and pmeMFEJourney>=pmeMatureJourney))
bool pmeExhaustion=pmeMature and ((not na(pmeGiveback) and pmeGiveback>=pmeGivebackWarn) or pmeStalled or pmeCounterMss)
string pmeState=not showPME?"HIDDEN":not pmeActive?"NO READY POSITION":pmeStopHit?"STOP REACHED":pmeCounterDisp?"REVERSAL CONFIRMED":pmeExhaustion?"EXHAUSTION RISK":pmeTargetHit?"TARGET REACHED":pmeMature?"MATURE":pmeMFEPrice>0?"EXPANDING":"EARLY"
string pmeJourneyText=not pmeActive?"--":(na(pmeJourney)?"NO TARGET":str.tostring(pmeJourney,"#.0")+"% NOW | "+str.tostring(pmeMFEJourney,"#.0")+"% MFE")
string pmeExcursionText=not pmeActive?"--":str.tostring(pmeMFEATR,"#.##")+" ATR MFE | "+str.tostring(pmeCurrentATR,"#.##")+" NOW"
string pmeGivebackText=not pmeActive?"--":str.tostring(pmeGiveback,"#.0")+"% | "+(pmeStalled?"STALL":"FLOW")
string pmeCounterText=not pmeActive?"--":not pmeCounterActive and not pmeCounterMss?"NONE":pmeCounterOwner+" "+(pmeCounterDir==1?"SSL ↑":"BSL ↓")+" | "+(pmeCounterDisp?"MSS ✓ DISP ✓":pmeCounterMss?"MSS ✓ WAIT DISP":"SWEEP ✓ WAIT MSS")

// End the observation only after metrics for the terminal bar have been captured.
bool pmeWindowEnd=pmeActive and bar_index-pmeStartBar>=pmeMaxBars
if barstate.isconfirmed and pmeActive and (pmeStopHit or pmeWindowEnd)
    pmeActive:=false
    pmeCounterActive:=false

// v1.0.9 observational outcome counters. A primary failure is counted only when
// EXEC ends without READY through an existing failure/timeout path. These metrics
// do not alter EXEC and are intended to answer the counter-structure research question.
var int primaryFailures=0
var int matureCounterBeforeFailure=0
var int primaryReadyEvents=0
var int matureCounterBeforeReady=0
var int counterSweepsSeen=0
var int counterMssSeen=0
var int counterDispSeen=0
var bool countedCounterSweep=false
var bool countedCounterMss=false
var bool countedCounterDisp=false
if newCounter
    counterSweepsSeen+=1
    countedCounterSweep:=true
    countedCounterMss:=false
    countedCounterDisp:=false
if counterMss and not countedCounterMss
    counterMssSeen+=1
    countedCounterMss:=true
if counterDisp and not countedCounterDisp
    counterDispSeen+=1
    countedCounterDisp:=true
bool primaryFailureEvent=confirmed and active[1] and not active and not consumed and (status=="EXPIRED / INVALID" or status=="DISPLACEMENT TIMEOUT" or status=="15M GAP TIMEOUT" or status=="ZONE INVALID")
if primaryFailureEvent
    primaryFailures+=1
    if counterDisp and not na(counterDispBar) and counterDispBar<=bar_index
        matureCounterBeforeFailure+=1
    counterActive:=false
bool primaryReadyEvent=confirmed and ready
if primaryReadyEvent
    primaryReadyEvents+=1
    if counterDisp and not na(counterDispBar) and counterDispBar<=bar_index
        matureCounterBeforeReady+=1
    counterActive:=false
float counterWarningRate=primaryFailures>0?100.0*matureCounterBeforeFailure/primaryFailures:na
float counterFalseRate=primaryReadyEvents>0?100.0*matureCounterBeforeReady/primaryReadyEvents:na
float counterPrecision=(matureCounterBeforeFailure+matureCounterBeforeReady)>0?100.0*matureCounterBeforeFailure/(matureCounterBeforeFailure+matureCounterBeforeReady):na

// ============================================================================
// SWEEP REACTION LIFECYCLE (SRI) - RESEARCH ONLY
// This module reads an EXEC-locked sweep but NEVER writes EXEC state.
// Peak and follow-through are historical; current state is independent.
// ============================================================================
string GSRI="7. Sweep reaction research (display only)"
bool showSRI=input.bool(true,"Show sweep reaction dashboard",group=GSRI)
int sriMemory=input.int(72,"Reaction observation window (M5 bars)",minval=6,maxval=288,group=GSRI)
float sriStrongATR=input.float(1.5,"Strong reaction distance (event ATR)",minval=0.25,step=0.25,group=GSRI)
float sriFollowATR=input.float(0.5,"Follow-through threshold (event ATR)",minval=0.1,step=0.1,group=GSRI)
float sriInvalidATR=input.float(0.25,"Invalidation beyond sweep extreme (event ATR)",minval=0.0,step=0.05,group=GSRI)
float sriFlatATR=input.float(0.12,"Consolidation change (event ATR)",minval=0.01,step=0.01,group=GSRI)
var int sriBar=na
var int sriDir=0
var string sriOwner=""
var float sriLevel=na
var float sriExtreme=na
var float sriATR=na
var float sriBest=na
var float sriLastClose=na
var float sriWickPct=na
var float sriCloseBack=na
var bool sriInvalid=false
var bool sriFollow=false
var string sriLiveState="NO SWEEP"
var int sriPeakBar=na
// Event identity comes exclusively from the existing EXEC sweep lock.
// A later qualified EXEC event starts a new observation; an EXEC timeout
// cannot reset or reclassify the prior research event.
bool sriNewEvent=confirmed and winner>=0 and sweepBar==bar_index and active and not na(sweepPrice)
if sriNewEvent
    sriBar:=bar_index
    sriDir:=dir
    sriOwner:=owner
    sriLevel:=sweepPrice
    sriExtreme:=dir==1?low:high
    sriATR:=atr
    sriBest:=dir==1?high:low
    sriLastClose:=close
    float sriRange=math.max(high-low,syminfo.mintick)
    sriWickPct:=dir==1?(math.min(open,close)-low)/sriRange:(high-math.max(open,close))/sriRange
    sriCloseBack:=dir==1?(close-sriLevel)/math.max(sriATR,syminfo.mintick):(sriLevel-close)/math.max(sriATR,syminfo.mintick)
    sriInvalid:=false
    sriFollow:=false
    sriLiveState:="DEVELOPING"
    sriPeakBar:=bar_index
bool sriInWindow=not na(sriBar) and bar_index-sriBar<=sriMemory
// Process confirmed candles only. Record any new favorable extreme BEFORE
// evaluating invalidation on that same candle, so historical peak survives.
if confirmed and sriInWindow and not sriNewEvent and not sriInvalid
    float sriCandidate=sriDir==1?high:low
    bool sriNewPeak=sriDir==1?sriCandidate>sriBest:sriCandidate<sriBest
    if sriNewPeak
        sriBest:=sriCandidate
        sriPeakBar:=bar_index
    float sriFavorable=sriDir==1?(close-sriLevel):(sriLevel-close)
    sriFollow:=sriFollow or sriFavorable>=sriFollowATR*sriATR
    bool sriNowInvalid=sriDir==1?close<sriExtreme-sriInvalidATR*sriATR:close>sriExtreme+sriInvalidATR*sriATR
    float sriDelta=(sriDir==1?close-sriLastClose:sriLastClose-close)/math.max(sriATR,syminfo.mintick)
    if sriNowInvalid
        sriInvalid:=true
        sriLiveState:="INVALIDATED"
    else if math.abs(sriDelta)<=sriFlatATR
        sriLiveState:="CONSOLIDATING"
    else if sriDelta<0
        sriLiveState:="RETRACING"
    else if sriNewPeak
        sriLiveState:="EXPANDING"
    else
        sriLiveState:="RECOVERING"
    sriLastClose:=close
// Freeze the last confirmed observation when the window ends. Historical
// peak remains available; current market state is no longer being tracked.
string sriState=na(sriBar)?"NO SWEEP":sriInvalid?"INVALIDATED":not sriInWindow?"OBSERVATION ENDED":sriLiveState
float sriPeakDistance=not na(sriATR) and sriATR>0 and not na(sriBest)?math.max(0.0,(sriDir==1?sriBest-sriExtreme:sriExtreme-sriBest)/sriATR):na
float sriCurrentDistance=not na(sriATR) and sriATR>0 and not na(sriLastClose)?(sriDir==1?sriLastClose-sriExtreme:sriExtreme-sriLastClose)/sriATR:na
string sriQuality=na(sriBar)?"NONE":sriWickPct>=0.35 and sriCloseBack>=0.08?"WICK + RECLAIM":sriCloseBack>=0.05?"RECLAIM":"SHALLOW"
string sriPeakText=na(sriPeakDistance)?"--":str.tostring(sriPeakDistance,"#.##")+" ATR"
string sriCurrentText=na(sriCurrentDistance)?"--":str.tostring(sriCurrentDistance,"#.##")+" ATR"+(sriInvalid or not sriInWindow?" (LAST)":"")
// ============================================================================
// Research classification is DISPLAY ONLY. Never referenced by `ready`.
int evidence=(bias4==1?1:bias4==-1?-1:0)+(bias1==1?1:bias1==-1?-1:0)+(e20>e50?1:e20<e50?-1:0)
string pressure=math.abs(evidence)<2?"NEUTRAL":active?(evidence*dir>0?"ALIGNED":"CONFLICT"):evidence>0?"BULL WATCH":"BEAR WATCH"
// Visual NAV: retire the old segment and start a NEW horizontal line when the
// nearest active pool changes. No plot() series joins distinct prices.
if barstate.islast
    if not na(navBSL)
        line.delete(navBSL)
        navBSL:=na
    if not na(navSSL)
        line.delete(navSSL)
        navSSL:=na
    if showLiq and not na(upper)
        navBSL:=line.new(math.max(0,bar_index-navLength),upper,bar_index+4,upper,xloc=xloc.bar_index,color=color.new(color.red,58),width=1,style=line.style_dashed)
    if showLiq and not na(lower)
        navSSL:=line.new(math.max(0,bar_index-navLength),lower,bar_index+4,lower,xloc=xloc.bar_index,color=color.new(color.teal,58),width=1,style=line.style_dashed)
// ============================================================================
// VISUAL-ONLY DAILY REFERENCE OVERLAY. PDH / PDL use the existing confirmed
// TradingView daily series. NY TDO is the OPEN of the first available M5 bar
// on the new NY calendar date; on markets without a midnight bar it is the
// first available bar, not an invented midnight transaction price.
// ============================================================================
int nyDayKey=year(time,"America/New_York")*10000+month(time,"America/New_York")*100+dayofmonth(time,"America/New_York")
var int lastNyDayKey=na
var float nyTdo=na
var int nyTdoStart=na
if na(lastNyDayKey) or nyDayKey!=lastNyDayKey
    nyTdo:=open
    nyTdoStart:=bar_index
    lastNyDayKey:=nyDayKey
float tvTdo=request.security(syminfo.tickerid,"D",open,lookahead=barmerge.lookahead_on)
float displayTdo=tdoMode=="New York midnight"?nyTdo:tvTdo
// ============================================================================
// TDO OWNERSHIP RESEARCH - v1.0.11 RESEARCH / DISPLAY ONLY
// This block NEVER writes EXEC state and is never referenced by READY.
// Ownership deliberately requires a full observation window, >= configured
// close acceptance on one side and current ATR-normalised separation from TDO.
// ============================================================================
bool newNyDay=not na(lastNyDayKey[1]) and nyDayKey!=lastNyDayKey[1]
var int tdoDayBars=0
if newNyDay
    tdoDayBars:=1
else if onM5 and barstate.isconfirmed
    tdoDayBars+=1
float tdoAbovePct=100.0*ta.sma(close>displayTdo?1.0:0.0,tdoOwnBars)
float tdoBelowPct=100.0*ta.sma(close<displayTdo?1.0:0.0,tdoOwnBars)
float tdoDistATR=not na(displayTdo)?math.abs(close-displayTdo)/math.max(atr,syminfo.mintick):na
bool tdoWindowReady=onM5 and tdoDayBars>=tdoOwnBars and not na(tdoAbovePct) and not na(tdoBelowPct)
bool tdoBullQualified=tdoWindowReady and tdoAbovePct>=tdoOwnPct and close>displayTdo and tdoDistATR>=tdoMinDistATR
bool tdoBearQualified=tdoWindowReady and tdoBelowPct>=tdoOwnPct and close<displayTdo and tdoDistATR>=tdoMinDistATR
var int tdoOwnerDir=0
var int tdoOwnershipBar=na
if newNyDay
    tdoOwnerDir:=0
    tdoOwnershipBar:=na
if barstate.isconfirmed
    if tdoBullQualified and tdoOwnerDir!=1
        tdoOwnerDir:=1
        tdoOwnershipBar:=bar_index
    else if tdoBearQualified and tdoOwnerDir!=-1
        tdoOwnerDir:=-1
        tdoOwnershipBar:=bar_index
// Ownership is intentionally sticky until the opposite side earns qualification.
// This makes LOSING / RECLAIMING visible without letting one cross flip ownership.
string tdoFlowState=not showTdoFlow?"HIDDEN":not onM5?"USE M5":tdoOwnerDir==1?(close>=displayTdo?"BULL OWNED ↑":"LOSING ↓"):tdoOwnerDir==-1?(close<=displayTdo?"BEAR OWNED ↓":"RECLAIMING ↑"):"CONTESTED ↔"
int tdoThesisDir=active?dir:(bias4==bias1?bias4:0)
bool tdoConflictNow=tdoOwnerDir!=0 and tdoThesisDir!=0 and tdoOwnerDir==-tdoThesisDir
string tdoFlowText=tdoFlowState+(tdoConflictNow?" ⚠":"")

// Freeze latest EXEC-event research evidence. These variables answer whether TDO
// conflict appeared before the existing counter-structure MSS warning.
var int tdoEventDir=0
var int tdoEventBar=na
var int tdoEventOwnerDir=0
var bool tdoEventConflict=false
var int tdoFirstConflictBar=na
var int tdoFirstCounterBar=na
var int tdoLeadBars=na
if sriNewEvent
    tdoEventDir:=dir
    tdoEventBar:=bar_index
    tdoEventOwnerDir:=tdoOwnerDir
    tdoEventConflict:=tdoOwnerDir!=0 and tdoOwnerDir==-dir
    tdoFirstConflictBar:=tdoEventConflict?bar_index:na
    tdoFirstCounterBar:=na
    tdoLeadBars:=na
if not na(tdoEventBar) and na(tdoFirstConflictBar) and tdoOwnerDir!=0 and tdoOwnerDir==-tdoEventDir
    tdoFirstConflictBar:=bar_index
    tdoEventConflict:=true
if not na(tdoEventBar) and na(tdoFirstCounterBar) and counterMss and not na(counterMssBar) and counterMssBar>=tdoEventBar
    tdoFirstCounterBar:=counterMssBar
if not na(tdoFirstConflictBar) and not na(tdoFirstCounterBar)
    tdoLeadBars:=tdoFirstCounterBar-tdoFirstConflictBar
string tdoLeadText=na(tdoEventBar)?"NO EVENT":not tdoEventConflict?"NO CONFLICT":na(tdoFirstCounterBar)?"TDO FIRST | COUNTER WAIT":tdoLeadBars>0?"TDO +"+str.tostring(tdoLeadBars)+" BARS":tdoLeadBars==0?"SAME BAR":"COUNTER +"+str.tostring(math.abs(tdoLeadBars))+" BARS"
var line pdhGuide=na
var line pdlGuide=na
var line tdoGuide=na
var label pdhTag=na
var label pdlTag=na
var label tdoTag=na
if barstate.islast
    if not na(pdhGuide)
        line.delete(pdhGuide)
    if not na(pdlGuide)
        line.delete(pdlGuide)
    if not na(tdoGuide)
        line.delete(tdoGuide)
    if not na(pdhTag)
        label.delete(pdhTag)
    if not na(pdlTag)
        label.delete(pdlTag)
    if not na(tdoTag)
        label.delete(tdoTag)
    int xLeft=math.max(0,bar_index-60)
    int xRight=bar_index+refLabelOffset
    if showPDH and not na(pdh)
        pdhGuide:=line.new(xLeft,pdh,xRight,pdh,xloc=xloc.bar_index,color=color.rgb(255,105,105),width=refLineWidth,style=line.style_dashed)
        pdhTag:=label.new(xRight,pdh,"PDH  "+str.tostring(pdh,format.mintick),xloc=xloc.bar_index,style=label.style_label_left,color=color.rgb(130,39,45),textcolor=color.white,size=size.small)
    if showPDL and not na(pdl)
        pdlGuide:=line.new(xLeft,pdl,xRight,pdl,xloc=xloc.bar_index,color=color.rgb(42,211,172),width=refLineWidth,style=line.style_dashed)
        pdlTag:=label.new(xRight,pdl,"PDL  "+str.tostring(pdl,format.mintick),xloc=xloc.bar_index,style=label.style_label_left,color=color.rgb(13,104,83),textcolor=color.white,size=size.small)
    if showTDO and not na(displayTdo)
        int tdoLeft=tdoMode=="New York midnight"?nyTdoStart:xLeft
        tdoGuide:=line.new(tdoLeft,displayTdo,xRight,displayTdo,xloc=xloc.bar_index,color=color.rgb(255,207,65),width=refLineWidth,style=line.style_dashed)
        tdoTag:=label.new(xRight,displayTdo,"TDO  "+str.tostring(displayTdo,format.mintick),xloc=xloc.bar_index,style=label.style_label_left,color=color.rgb(142,103,17),textcolor=color.white,size=size.small)
// ============================================================================
// Target guides are observational drawings. Only the existing READY boolean
// can promote provisional geometry into an executable projection.
if barstate.islast
    if not na(guideEntry)
        line.delete(guideEntry)
        guideEntry:=na
    if not na(guideStop)
        line.delete(guideStop)
        guideStop:=na
    if not na(guideTarget)
        line.delete(guideTarget)
        guideTarget:=na
    if not na(guideLabel)
        label.delete(guideLabel)
        guideLabel:=na
    bool readyProjection=consumed and not na(entry) and not na(stop) and not na(target)
    bool provisionalProjection=active and gap and not na(ce) and not na(structuralStop) and not na(bestTarget)
    if showTargetGuides and (readyProjection or provisionalProjection)
        float drawEntry=readyProjection?entry:ce
        float drawStop=readyProjection?stop:structuralStop
        float drawTarget=readyProjection?target:bestTarget
        color guideColor=readyProjection?color.lime:color.new(color.yellow,45)
        guideEntry:=line.new(bar_index,drawEntry,bar_index+8,drawEntry,color=guideColor,style=line.style_dotted)
        guideStop:=line.new(bar_index,drawStop,bar_index+8,drawStop,color=color.new(color.red,readyProjection?15:60),style=line.style_dotted)
        guideTarget:=line.new(bar_index,drawTarget,bar_index+8,drawTarget,color=guideColor,style=line.style_dashed,width=2)
        guideLabel:=label.new(bar_index+8,drawTarget,(readyProjection?"READY TP ":"PROVISIONAL TP ")+str.tostring(drawTarget,format.mintick),style=label.style_label_left,color=readyProjection?color.new(color.green,15):color.new(color.gray,30),textcolor=color.white,size=size.small)
// CE guide is presentation-only. The existing CE, rejection and READY calculations above remain untouched.
// Use one last-bar horizontal guide and label, not a stepped plot between separate FVGs.
if barstate.islast
    if not na(ceGuide)
        line.delete(ceGuide)
        ceGuide:=na
    if not na(ceGuideLabel)
        label.delete(ceGuideLabel)
        ceGuideLabel:=na
    if showZone and showCELabel and active and gap and not na(ce)
        ceGuide:=line.new(bar_index,ce,bar_index+8,ce,xloc=xloc.bar_index,color=color.aqua,width=2,style=line.style_dashed)
        ceGuideLabel:=label.new(bar_index+8,ce,branch+" CE 50%  "+str.tostring(ce,format.mintick),xloc=xloc.bar_index,style=label.style_label_left,color=color.new(color.teal,15),textcolor=color.white,size=size.small)
plot(active and gap?ce:na,"Active CE",color=color.aqua,linewidth=2,style=plot.style_linebr)
plot(consumed?entry:na,"Last READY entry",display=display.data_window)
plot(consumed?stop:na,"Last READY stop",display=display.data_window)
plot(consumed?target:na,"Last READY target",display=display.data_window)
plot(consumed?rr:na,"Last READY RR",display=display.data_window)
// Dashboard is display-only: no status string or context classification gates READY.
string nextStep=not onM5?"SWITCH TO 5M":active?not mss?"WAIT M5 MSS":not disp?"WAIT DISPLACEMENT":not gap?"WAIT CLOSED 15M FVG / IFVG":not geometry?"WAIT VALID >=2R TARGET":"WAIT CE RETEST + M5 REJECTION":consumed?"READY EVENT RECORDED":"WAIT QUALIFIED SWEEP"
string setupStage=not active and not consumed?"NO ACTIVE SETUP":consumed?"READY RECORDED":mss?(disp?(gap?"ZONE CONFIRMED":"DISP CONFIRMED"):"MSS CONFIRMED"):"SWEEP LOCKED"
bool validProvisional=active and gap and geometry and not na(bestTarget)
string targetState=consumed and not na(target)?"READY TP":validProvisional?"PROVISIONAL >=2R":active and gap?"NO VALID >=2R TARGET":"PENDING"
string targetValue=consumed and not na(target)?str.tostring(target,format.mintick):validProvisional?str.tostring(bestTarget,format.mintick):"--"
string entryValue=consumed and not na(entry)?str.tostring(entry,format.mintick):active and gap?str.tostring(ce,format.mintick):"--"
string stopValue=consumed and not na(stop)?str.tostring(stop,format.mintick):active and gap?str.tostring(structuralStop,format.mintick):"--"
string rrValue=consumed and not na(rr)?str.tostring(rr,"#.##")+"R":validProvisional?str.tostring(projectedRR,"#.##")+"R":"--"
// Informational 4H clock only. time_close("240") follows the symbol's exchange 4H bars.
// timenow updates only when TradingView executes the script (normally on incoming ticks).
int fourHClose=time_close("240")
int fourHRemaining=not na(fourHClose)?math.max(0,int(math.floor((fourHClose-timenow)/1000))):0
int fourHHours=int(math.floor(fourHRemaining/3600))
int fourHMinutes=int(math.floor(fourHRemaining%3600/60))
int fourHSeconds=fourHRemaining%60
string fourHCountdown=not na(fourHClose)?str.tostring(fourHHours,"00")+":"+str.tostring(fourHMinutes,"00")+":"+str.tostring(fourHSeconds,"00"):"N/A"
// CLOSED is shown on the confirmed final M5 bar of a 4H candle, otherwise OPEN.
bool fourHBoundary=onM5 and barstate.isconfirmed and not na(fourHClose) and time_close==fourHClose
string fourHCandleState=fourHBoundary?"CLOSED":"OPEN"
string fvgCeState=active and gap and not na(ce)?branch+" | CE "+str.tostring(ce,format.mintick):"WAIT CLOSED 15M GAP"
// Dashboard presentation only. The execution and research calculations above are unchanged.
var table dash=table.new(position.top_right,2,34,bgcolor=color.new(color.black,17),frame_color=color.new(color.gray,60),frame_width=1)
if barstate.islast
    table.clear(dash,0,0,1,33)
    if showDash
        bool compact= dashMode=="Compact"
        bool showTrade=active or consumed
        string shortStatus=status=="15M GAP TIMEOUT"?"GAP TIMEOUT":status=="DISPLACEMENT"?"DISP ✓":status
        string shortNext=not onM5?"USE M5":active?not mss?"WAIT MSS":not disp?"WAIT DISP":not gap?"WAIT 15M GAP":not geometry?"WAIT >=2R":"WAIT CE + M5":consumed?"READY RECORDED":"WAIT SWEEP"
        string bullCe=ctxBullState==0?"--":str.tostring((ctxBullTop+ctxBullBottom)/2.0,format.mintick)
        string bearCe=ctxBearState==0?"--":str.tostring((ctxBearTop+ctxBearBottom)/2.0,format.mintick)
        string reactOwner=na(sriBar)?"NONE":sriOwner+(sriDir==1?" SSL ↑":" BSL ↓")
        string peakNow=showSRI?sriPeakText+" / "+sriCurrentText:"HIDDEN"
        string execCe=active and gap?str.tostring(ce,format.mintick):consumed?"READY RECORDED":"NONE"
        string biasText=(bias4==1?"BULL":bias4==-1?"BEAR":"NEUT")+" / "+(bias1==1?"BULL":bias1==-1?"BEAR":"NEUT")
        table.cell(dash,0,0,"ALGOMIND",text_color=color.white,bgcolor=color.new(color.blue,45),text_size=size.small)
        table.cell(dash,1,0,"v1.0.12 | M5",text_color=color.white,bgcolor=color.new(color.blue,45),text_size=size.small)
        if compact
            table.cell(dash,0,1,"EXEC",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,1,onM5?shortStatus:"USE M5",text_color=consumed?color.lime:color.white,text_size=size.small)
            table.cell(dash,0,2,"NEXT",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,2,shortNext,text_color=color.yellow,text_size=size.small)
            table.cell(dash,0,3,"BIAS 4H/1H",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,3,biasText,text_color=color.white,text_size=size.small)
            table.cell(dash,0,4,"SWEEP",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,4,owner==""?"NONE":owner,text_color=color.white,text_size=size.small)
            table.cell(dash,0,5,"15M BULL CE",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,5,bullCe,text_color=color.teal,text_size=size.small)
            table.cell(dash,0,6,"15M BEAR CE",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,6,bearCe,text_color=color.orange,text_size=size.small)
            table.cell(dash,0,7,"EXEC FVG",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,7,execCe,text_color=color.aqua,text_size=size.small)
            table.cell(dash,0,8,"REACTION",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,8,showSRI?sriState:"HIDDEN",text_color=sriInvalid?color.red:color.white,text_size=size.small)
            table.cell(dash,0,9,"PEAK / NOW",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,9,peakNow,text_color=color.aqua,text_size=size.small)
            table.cell(dash,0,10,"FOLLOW",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,10,showSRI?(sriFollow?"YES":"WAIT"):"HIDDEN",text_color=color.white,text_size=size.small)
            table.cell(dash,0,11,"4H CLOSE",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,11,show4HClock?fourHCountdown:"HIDDEN",text_color=color.yellow,text_size=size.small)
            table.cell(dash,0,12,"4H CANDLE",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,12,show4HClock?fourHCandleState:"HIDDEN",text_color=fourHBoundary?color.lime:color.white,text_size=size.small)
            table.cell(dash,0,15,"LIVE LIQ",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,15,liveText,text_color=rtState=="SWEEPING" or rtState=="RECLAIM?"?color.yellow:color.white,text_size=size.small)
            table.cell(dash,0,16,"COUNTER",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,16,counterText,text_color=counterDisp?color.aqua:counterMss?color.yellow:color.white,text_size=size.small)
            table.cell(dash,0,17,"FAIL WARN",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,17,primaryFailures>0?"FAIL "+str.tostring(counterWarningRate,"#.0")+"% | PREC "+(primaryReadyEvents==0?"N/A":na(counterPrecision)?"--":str.tostring(counterPrecision,"#.0")+"%") : "NO SAMPLE",text_color=color.white,text_size=size.small)
            table.cell(dash,0,18,"MATURITY",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,18,pmeState,text_color=pmeCounterDisp?color.red:pmeExhaustion?color.yellow:pmeMature?color.aqua:color.white,text_size=size.small)
            table.cell(dash,0,19,"JOURNEY",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,19,pmeJourneyText,text_color=color.white,text_size=size.small)
            table.cell(dash,0,20,"MFE / NOW",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,20,pmeExcursionText,text_color=color.aqua,text_size=size.small)
            table.cell(dash,0,21,"POS COUNTER",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,21,pmeCounterText,text_color=pmeCounterDisp?color.red:pmeCounterMss?color.yellow:color.white,text_size=size.small)
            table.cell(dash,0,22,"TDO FLOW",text_color=color.silver,text_size=size.tiny)
            table.cell(dash,1,22,tdoFlowText,text_color=tdoConflictNow?color.yellow:tdoOwnerDir==1?color.lime:tdoOwnerDir==-1?color.red:color.white,text_size=size.small)
            if showTrade
                table.cell(dash,0,13,"ENTRY / SL",text_color=color.silver,text_size=size.tiny)
                table.cell(dash,1,13,entryValue+" / "+stopValue,text_color=color.white,text_size=size.small)
                table.cell(dash,0,14,"TP / RR",text_color=color.silver,text_size=size.tiny)
                table.cell(dash,1,14,targetValue+" / "+rrValue,text_color=color.white,text_size=size.small)
        else
            table.cell(dash,0,0,"ALGOMIND UNIFIED",text_color=color.white,bgcolor=color.new(color.blue,45))
            table.cell(dash,1,0,"v1.0.12 | M5",text_color=color.white,bgcolor=color.new(color.blue,45))
            table.cell(dash,0,1,"EXEC STATUS",text_color=color.silver)
            table.cell(dash,1,1,onM5?status:"SWITCH TO 5M",text_color=consumed?color.lime:color.white)
            table.cell(dash,0,2,"NEXT REQUIRED",text_color=color.silver)
            table.cell(dash,1,2,nextStep,text_color=color.yellow)
            table.cell(dash,0,3,"SWEEP OWNER",text_color=color.silver)
            table.cell(dash,1,3,owner==""?"NONE":owner,text_color=color.white)
            table.cell(dash,0,4,"PROGRESS",text_color=color.silver)
            table.cell(dash,1,4,setupStage+" | "+(gap?branch:"15M GAP ○"),text_color=color.white)
            table.cell(dash,0,5,"EXEC BIAS 4H/1H",text_color=color.silver)
            table.cell(dash,1,5,str.tostring(bias4)+" / "+str.tostring(bias1),text_color=color.white)
            table.cell(dash,0,6,"FUSION ST / PZ",text_color=color.silver)
            table.cell(dash,1,6,fusionBias+" / "+pressure,text_color=color.white)
            table.cell(dash,0,7,"TARGET STATUS",text_color=color.silver)
            table.cell(dash,1,7,targetState,text_color=consumed?color.lime:validProvisional?color.yellow:color.silver)
            table.cell(dash,0,8,"ENTRY / STOP",text_color=color.silver)
            table.cell(dash,1,8,entryValue+" / "+stopValue,text_color=color.white)
            table.cell(dash,0,9,"TARGET",text_color=color.silver)
            table.cell(dash,1,9,targetValue,text_color=consumed?color.lime:color.white)
            table.cell(dash,0,10,"REALISTIC RR",text_color=color.silver)
            table.cell(dash,1,10,rrValue,text_color=consumed?color.lime:color.white)
            table.cell(dash,0,11,"15M FVG / CE",text_color=color.silver)
            table.cell(dash,1,11,fvgCeState,text_color=active and gap?color.aqua:color.silver)
            table.cell(dash,0,12,"NEXT 4H CLOSE",text_color=color.silver)
            table.cell(dash,1,12,show4HClock?fourHCountdown:"HIDDEN",text_color=color.yellow)
            table.cell(dash,0,13,"4H CANDLE",text_color=color.silver)
            table.cell(dash,1,13,show4HClock?fourHCandleState:"HIDDEN",text_color=fourHBoundary?color.lime:color.white)
            table.cell(dash,0,14,"15M BULL CONTEXT",text_color=color.silver)
            table.cell(dash,1,14,ctxBullState == 0 ? "NONE" : (ctxBullInverse ? "BEAR IFVG " : "BULL FVG ") + ctxStateName(ctxBullState) + " | CE " + str.tostring((ctxBullTop + ctxBullBottom) / 2.0, format.mintick),text_color=color.teal)
            table.cell(dash,0,15,"15M BEAR CONTEXT",text_color=color.silver)
            table.cell(dash,1,15,ctxBearState == 0 ? "NONE" : (ctxBearInverse ? "BULL IFVG " : "BEAR FVG ") + ctxStateName(ctxBearState) + " | CE " + str.tostring((ctxBearTop + ctxBearBottom) / 2.0, format.mintick),text_color=color.orange)
            table.cell(dash,0,16,"EXEC FVG / CE",text_color=color.silver)
            table.cell(dash,1,16,active and gap ? "EXEC FVG ACTIVE | CE " + str.tostring(ce,format.mintick) : consumed ? "READY EVENT RECORDED" : "NO EXEC FVG",text_color=active and gap ? color.aqua : color.silver)
            table.cell(dash,0,17,"SWEEP REACTION",text_color=color.silver)
            table.cell(dash,1,17,showSRI?sriState:"HIDDEN",text_color=sriInvalid?color.red:sriState=="EXPANDING"?color.lime:color.silver)
            table.cell(dash,0,18,"REACTION OWNER",text_color=color.silver)
            table.cell(dash,1,18,showSRI?(na(sriBar)?"NONE":sriOwner+(sriDir==1?" SSL ↑":" BSL ↓")):"HIDDEN",text_color=color.white)
            table.cell(dash,0,19,"REJECTION / FOLLOW",text_color=color.silver)
            table.cell(dash,1,19,showSRI?(sriQuality+" / "+(sriFollow?"YES":"WAIT")):"HIDDEN",text_color=color.white)
            table.cell(dash,0,20,"PEAK REACTION",text_color=color.silver)
            table.cell(dash,1,20,showSRI?sriPeakText:"HIDDEN",text_color=color.aqua)
            table.cell(dash,0,21,"CURRENT DISTANCE",text_color=color.silver)
            table.cell(dash,1,21,showSRI?sriCurrentText:"HIDDEN",text_color=color.aqua)
            table.cell(dash,0,22,"REACTION PHASE",text_color=color.silver)
            table.cell(dash,1,22,showSRI?(sriFollow?"FOLLOW CONFIRMED":"FOLLOW WAIT")+(not na(sriPeakDistance) and sriPeakDistance>=sriStrongATR?" | PEAK >= THRESHOLD":""):"HIDDEN",text_color=color.white)
            table.cell(dash,0,23,"LIVE LIQUIDITY",text_color=color.silver)
            table.cell(dash,1,23,liveText,text_color=rtState=="SWEEPING" or rtState=="RECLAIM?"?color.yellow:color.white)
            table.cell(dash,0,24,"COUNTER STRUCTURE",text_color=color.silver)
            table.cell(dash,1,24,counterText,text_color=counterDisp?color.aqua:counterMss?color.yellow:color.white)
            table.cell(dash,0,25,"COUNTER EVENTS",text_color=color.silver)
            table.cell(dash,1,25,str.tostring(counterSweepsSeen)+" SWP | "+str.tostring(counterMssSeen)+" MSS | "+str.tostring(counterDispSeen)+" DISP",text_color=color.white)
            table.cell(dash,0,26,"COUNTER EVIDENCE",text_color=color.silver)
            table.cell(dash,1,26,primaryFailures>0?"FAIL "+str.tostring(matureCounterBeforeFailure)+"/"+str.tostring(primaryFailures)+" "+str.tostring(counterWarningRate,"#.0")+"% | READY "+str.tostring(matureCounterBeforeReady)+"/"+str.tostring(primaryReadyEvents)+" | PREC "+(primaryReadyEvents==0?"N/A":na(counterPrecision)?"--":str.tostring(counterPrecision,"#.0")+"%") : "NO SAMPLE",text_color=color.white)
            table.cell(dash,0,27,"POSITION MATURITY",text_color=color.silver)
            table.cell(dash,1,27,pmeState,text_color=pmeCounterDisp?color.red:pmeExhaustion?color.yellow:pmeMature?color.aqua:color.white)
            table.cell(dash,0,28,"TARGET JOURNEY",text_color=color.silver)
            table.cell(dash,1,28,pmeJourneyText,text_color=color.white)
            table.cell(dash,0,29,"MFE / NOW",text_color=color.silver)
            table.cell(dash,1,29,pmeExcursionText,text_color=color.aqua)
            table.cell(dash,0,30,"GIVEBACK / FLOW",text_color=color.silver)
            table.cell(dash,1,30,pmeGivebackText,text_color=pmeExhaustion?color.yellow:color.white)
            table.cell(dash,0,31,"POSITION COUNTER",text_color=color.silver)
            table.cell(dash,1,31,pmeCounterText,text_color=pmeCounterDisp?color.red:pmeCounterMss?color.yellow:color.white)
            table.cell(dash,0,32,"TDO FLOW",text_color=color.silver)
            table.cell(dash,1,32,tdoFlowText,text_color=tdoConflictNow?color.yellow:tdoOwnerDir==1?color.lime:tdoOwnerDir==-1?color.red:color.white)
            table.cell(dash,0,33,"TDO LEAD",text_color=color.silver)
            table.cell(dash,1,33,tdoLeadText,text_color=not na(tdoLeadBars) and tdoLeadBars>0?color.aqua:color.white)
            // Hide trade fields when no setup is active or READY.
            if not showTrade
                table.cell(dash,0,7,"",text_color=color.silver)
                table.cell(dash,1,7,"",text_color=color.silver)
                for r=8 to 10
                    table.cell(dash,0,r,"",text_color=color.silver)
                    table.cell(dash,1,r,"",text_color=color.silver)
alertcondition(showEMACross and emaBullCross,"AlgoMind EMA Bull Cross","EMA20 crossed ABOVE EMA50 on confirmed M5 momentum")
alertcondition(showEMACross and emaBearCross,"AlgoMind EMA Bear Cross","EMA20 crossed BELOW EMA50 on confirmed M5 momentum")
alertcondition(showRT and (rtState=="SWEEPING" or rtState=="RECLAIM?"),"AlgoMind LIVE liquidity","AlgoMind v1.0.9 LIVE liquidity event")
alertcondition(showCounter and counterMss and not counterDisp,"AlgoMind counter MSS","AlgoMind v1.0.9 counter MSS confirmed")
alertcondition(showCounter and counterDisp,"AlgoMind counter DISP","AlgoMind v1.0.9 counter displacement confirmed")
alertcondition(showPME and pmeExhaustion,"AlgoMind position exhaustion risk","AlgoMind v1.0.10 position maturity: exhaustion risk")
alertcondition(showPME and pmeCounterDisp,"AlgoMind position reversal confirmed","AlgoMind v1.0.10 position maturity: counter displacement confirmed")
alertcondition(ready and dir==1,"AlgoMind Unified BUY READY","Confirmed BUY READY on AlgoMind Unified")
alertcondition(ready and dir==-1,"AlgoMind Unified SELL READY","Confirmed SELL READY on AlgoMind Unified")
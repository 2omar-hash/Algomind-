//@version=6
indicator("Gold Pivot Strength Map v1.2", "Pivot Strength v1.2", overlay=true, max_labels_count=300, max_lines_count=300)

//==============================================================================
// v1.2 PROVISIONAL INTELLIGENCE
//------------------------------------------------------------------------------
// Scope:
// - Preserve confirmed pivot logic.
// - Improve 1/x -> x/x provisional development.
// - Enforce ONE active provisional owner at a time.
// - Confirmed pivot highs display SELL + price.
// - Confirmed pivot lows display BUY + price.
// - No entry/SL/TP engine and no extra trading logic.
//==============================================================================

//==============================================================================
// INPUTS
//==============================================================================
groupPivot = "Pivot Engine"
groupStyle = "Style"
groupDash  = "Dashboard"

pivotLen        = input.int(10, "Pivot strength", minval=2, maxval=20, group=groupPivot)
minStrength     = input.int(1, "Minimum provisional strength", minval=1, maxval=10, group=groupPivot)
showProvisional = input.bool(true, "Show active provisional pivot", group=groupPivot)
showConfirmed   = input.bool(true, "Show confirmed pivots", group=groupPivot)
extendBars      = input.int(12, "Level line extension", minval=2, maxval=50, group=groupStyle)

highColor       = input.color(color.rgb(242,54,69), "SELL / high color", group=groupStyle)
lowColor        = input.color(color.rgb(8,153,129), "BUY / low color", group=groupStyle)
dashBg          = input.color(color.new(color.rgb(43,49,60), 8), "Dashboard background", group=groupDash)
dashText        = input.color(color.rgb(210,214,220), "Dashboard text", group=groupDash)
showDashboard   = input.bool(true, "Show dashboard", group=groupDash)

//==============================================================================
// HELPERS
//------------------------------------------------------------------------------
// Strength is the number of bars on both sides that currently validate the
// candidate, capped by pivotLen. A developing candidate can therefore mature
// naturally from 1/x toward x/x as new bars close.
//==============================================================================
f_strengthHigh(int back, int maxStrength) =>
    int s = 0
    float p = high[back]
    for i = 1 to maxStrength
        bool leftAvailable = not na(high[back + i])
        bool leftOK = leftAvailable and p >= high[back + i]

        // For a provisional candidate, right-side bars only exist when i <= back.
        // Missing future bars do not count as confirmation.
        bool rightAvailable = i <= back
        bool rightOK = rightAvailable and p > high[back - i]

        if leftOK and rightOK
            s += 1
        else
            break
    s

f_strengthLow(int back, int maxStrength) =>
    int s = 0
    float p = low[back]
    for i = 1 to maxStrength
        bool leftAvailable = not na(low[back + i])
        bool leftOK = leftAvailable and p <= low[back + i]

        bool rightAvailable = i <= back
        bool rightOK = rightAvailable and p < low[back - i]

        if leftOK and rightOK
            s += 1
        else
            break
    s

//==============================================================================
// CONFIRMED PIVOTS
//==============================================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastPivotHigh = na
var float lastPivotLow  = na
var int   lastPivotHighBar = na
var int   lastPivotLowBar  = na
var int   confirmedHighCount = 0
var int   confirmedLowCount  = 0
var float pivotGapSum = 0.0
var int   pivotGapCount = 0
var int   lastAnyPivotBar = na

if not na(ph)
    int pbar = bar_index - pivotLen
    lastPivotHigh := ph
    lastPivotHighBar := pbar
    confirmedHighCount += 1

    if not na(lastAnyPivotBar)
        pivotGapSum += math.abs(pbar - lastAnyPivotBar)
        pivotGapCount += 1
    lastAnyPivotBar := pbar

    if showConfirmed
        label.new(
             pbar,
             ph,
             "SELL\n" + str.tostring(ph, format.mintick),
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_down,
             color=highColor,
             textcolor=color.white,
             size=size.small)

        line.new(
             pbar,
             ph,
             pbar + extendBars,
             ph,
             xloc=xloc.bar_index,
             extend=extend.none,
             color=color.new(highColor, 35),
             style=line.style_dotted,
             width=1)

if not na(pl)
    int pbar = bar_index - pivotLen
    lastPivotLow := pl
    lastPivotLowBar := pbar
    confirmedLowCount += 1

    if not na(lastAnyPivotBar)
        pivotGapSum += math.abs(pbar - lastAnyPivotBar)
        pivotGapCount += 1
    lastAnyPivotBar := pbar

    if showConfirmed
        label.new(
             pbar,
             pl,
             "BUY\n" + str.tostring(pl, format.mintick),
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_up,
             color=lowColor,
             textcolor=color.white,
             size=size.small)

        line.new(
             pbar,
             pl,
             pbar + extendBars,
             pl,
             xloc=xloc.bar_index,
             extend=extend.none,
             color=color.new(lowColor, 35),
             style=line.style_dotted,
             width=1)

//==============================================================================
// PROVISIONAL INTELLIGENCE
//------------------------------------------------------------------------------
// Candidate ownership rules:
// 1. Scan only bars that are still capable of becoming the next confirmed pivot.
// 2. Score high and low candidates independently.
// 3. The candidate with the GREATER maturity owns the provisional state.
// 4. If maturity ties, the MORE RECENT candidate owns it.
// 5. Only ONE provisional candidate is displayed.
// 6. Ownership can transfer when the opposing candidate becomes stronger/more
//    recent. This prevents simultaneous provisional high + low clutter.
//==============================================================================
var label provisionalOwnerLabel = na
var line  provisionalOwnerLine  = na

int bestHighBack = na
int bestHighStrength = 0
float bestHighPrice = na

int bestLowBack = na
int bestLowStrength = 0
float bestLowPrice = na

int ownerSide = 0         // 1 = provisional high/SELL, -1 = provisional low/BUY
int ownerBack = na
int ownerStrength = 0
float ownerPrice = na

if barstate.islast
    label.delete(provisionalOwnerLabel)
    line.delete(provisionalOwnerLine)

    // Only bars 1..pivotLen-1 can still be provisional. Once back == pivotLen,
    // the normal confirmed pivot engine owns the event.
    int scanMax = math.max(1, pivotLen - 1)

    for back = 1 to scanMax
        int hs = f_strengthHigh(back, pivotLen)
        if hs >= minStrength and hs < pivotLen
            if hs > bestHighStrength or (hs == bestHighStrength and (na(bestHighBack) or back < bestHighBack))
                bestHighStrength := hs
                bestHighBack := back
                bestHighPrice := high[back]

        int ls = f_strengthLow(back, pivotLen)
        if ls >= minStrength and ls < pivotLen
            if ls > bestLowStrength or (ls == bestLowStrength and (na(bestLowBack) or back < bestLowBack))
                bestLowStrength := ls
                bestLowBack := back
                bestLowPrice := low[back]

    bool haveHigh = not na(bestHighBack)
    bool haveLow  = not na(bestLowBack)

    if haveHigh and not haveLow
        ownerSide := 1
        ownerBack := bestHighBack
        ownerStrength := bestHighStrength
        ownerPrice := bestHighPrice
    else if haveLow and not haveHigh
        ownerSide := -1
        ownerBack := bestLowBack
        ownerStrength := bestLowStrength
        ownerPrice := bestLowPrice
    else if haveHigh and haveLow
        if bestHighStrength > bestLowStrength
            ownerSide := 1
            ownerBack := bestHighBack
            ownerStrength := bestHighStrength
            ownerPrice := bestHighPrice
        else if bestLowStrength > bestHighStrength
            ownerSide := -1
            ownerBack := bestLowBack
            ownerStrength := bestLowStrength
            ownerPrice := bestLowPrice
        else
            // Equal maturity: newest candidate owns.
            if bestHighBack < bestLowBack
                ownerSide := 1
                ownerBack := bestHighBack
                ownerStrength := bestHighStrength
                ownerPrice := bestHighPrice
            else
                ownerSide := -1
                ownerBack := bestLowBack
                ownerStrength := bestLowStrength
                ownerPrice := bestLowPrice

    if showProvisional and ownerSide != 0 and not na(ownerBack)
        int xb = bar_index - ownerBack
        color ownerColor = ownerSide == 1 ? highColor : lowColor
        string ownerText = (ownerSide == 1 ? "SELL " : "BUY ") +
             str.tostring(ownerStrength) + "/" + str.tostring(pivotLen)

        provisionalOwnerLabel := label.new(
             xb,
             ownerPrice,
             ownerText,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             textcolor=ownerColor,
             color=color.new(color.white, 100),
             size=size.small)

        provisionalOwnerLine := line.new(
             xb,
             ownerPrice,
             xb + extendBars,
             ownerPrice,
             xloc=xloc.bar_index,
             extend=extend.none,
             color=color.new(ownerColor, 35),
             style=line.style_dotted,
             width=1)

//==============================================================================
// DASHBOARD
//==============================================================================
var table dash = table.new(position.top_right, 2, 8, border_width=0)

if barstate.islast and showDashboard
    float avgBarsPerPivot = pivotGapCount > 0 ? pivotGapSum / pivotGapCount : na
    int highAge = na(lastPivotHighBar) ? na : bar_index - lastPivotHighBar
    int lowAge  = na(lastPivotLowBar)  ? na : bar_index - lastPivotLowBar

    string ownerTextDash = ownerSide == 1 ? "SELL " + str.tostring(ownerStrength) + "/" + str.tostring(pivotLen) :
         ownerSide == -1 ? "BUY " + str.tostring(ownerStrength) + "/" + str.tostring(pivotLen) : "—"

    string ownerPriceText = ownerSide != 0 and not na(ownerPrice) ? str.tostring(ownerPrice, format.mintick) : "—"

    table.cell(dash, 0, 0, "Pivot Strength", text_color=dashText, bgcolor=dashBg, text_halign=text.align_left)
    table.cell(dash, 1, 0, "H " + str.tostring(pivotLen) + "/" + str.tostring(pivotLen) + " · L " + str.tostring(pivotLen) + "/" + str.tostring(pivotLen), text_color=dashText, bgcolor=dashBg)

    table.cell(dash, 0, 1, "Confirmation delay", text_color=dashText, bgcolor=dashBg, text_halign=text.align_left)
    table.cell(dash, 1, 1, str.tostring(pivotLen) + " · " + str.tostring(pivotLen) + " bars", text_color=dashText, bgcolor=dashBg)

    table.cell(dash, 0, 2, "Confirmed pivots", text_color=dashText, bgcolor=dashBg, text_halign=text.align_left)
    table.cell(dash, 1, 2, str.tostring(confirmedHighCount) + " H · " + str.tostring(confirmedLowCount) + " L", text_color=dashText, bgcolor=dashBg)

    table.cell(dash, 0, 3, "Avg bars per pivot", text_color=dashText, bgcolor=dashBg, text_halign=text.align_left)
    table.cell(dash, 1, 3, na(avgBarsPerPivot) ? "—" : str.tostring(avgBarsPerPivot, "#.0"), text_color=dashText, bgcolor=dashBg)

    table.cell(dash, 0, 4, "Last SELL pivot", text_color=dashText, bgcolor=dashBg, text_halign=text.align_left)
    table.cell(dash, 1, 4, na(lastPivotHigh) ? "—" : str.tostring(lastPivotHigh, format.mintick) + " · " + str.tostring(highAge) + " bars ago", text_color=dashText, bgcolor=dashBg)

    table.cell(dash, 0, 5, "Last BUY pivot", text_color=dashText, bgcolor=dashBg, text_halign=text.align_left)
    table.cell(dash, 1, 5, na(lastPivotLow) ? "—" : str.tostring(lastPivotLow, format.mintick) + " · " + str.tostring(lowAge) + " bars ago", text_color=dashText, bgcolor=dashBg)

    table.cell(dash, 0, 6, "Active provisional", text_color=dashText, bgcolor=dashBg, text_halign=text.align_left)
    table.cell(dash, 1, 6, ownerTextDash, text_color=ownerSide == 1 ? highColor : ownerSide == -1 ? lowColor : dashText, bgcolor=dashBg)

    table.cell(dash, 0, 7, "Candidate price", text_color=dashText, bgcolor=dashBg, text_halign=text.align_left)
    table.cell(dash, 1, 7, ownerPriceText, text_color=ownerSide == 1 ? highColor : ownerSide == -1 ? lowColor : dashText, bgcolor=dashBg)

//==============================================================================
// ALERTS
//==============================================================================
alertcondition(not na(ph), "Confirmed SELL Pivot", "A new confirmed pivot high / SELL pivot has formed.")
alertcondition(not na(pl), "Confirmed BUY Pivot", "A new confirmed pivot low / BUY pivot has formed.")
